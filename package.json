{
	"name": "scradd",
	"version": "0.0.0",
	"private": true,
	"homepage": "https://discord.gg/FPv957V6SD",
	"type": "module",
	"main": "./dist/index.js",
	"scripts": {
		"build": "rm -rf ./dist && tsc --project tsconfig.json",
		"dev": "tsc --project tsconfig.json --watch",
		"format": "prettier --write \"**\" \"!./dist/\" --ignore-unknown --cache",
		"lint": "eslint",
		"serve": "nodemon --env-file .env --enable-source-maps . --ext js,json",
		"start": "node --enable-source-maps .",
		"test": "node --run build && cd dist && node --enable-source-maps --test"
	},
	"browserslist": [
		"chrome 80",
		"edge 80",
		"opera 67",
		"ff 86"
	],
	"prettier": "@redguy12/prettier-config",
	"dependencies": {
		"@sa-community/addons-data": "1045.2.0",
		"discord.js": "14.26.4",
		"match-sorter": "8.3.0",
		"mongoose": "9.8.0",
		"posthtml-parser": "0.12.1",
		"strife.js": "4.4.0"
	},
	"devDependencies": {
		"@redguy12/prettier-config": "3.4.5",
		"@total-typescript/ts-reset": "0.6.1",
		"@types/node": "<=24.15",
		"eslint": "10.4.0",
		"eslint-config-cobaltt7": "1.4.1",
		"nodemon": "3.1.14",
		"prettier": "3.8.3",
		"typescript": "6.0.3"
	},
	"optionalDependencies": {
		"@railway/cli": "4.65.0"
	},
	"engines": {
		"node": "^24.15.0",
		"npm": ">=11.0.0"
	}
}
